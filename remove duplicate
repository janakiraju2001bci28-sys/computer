int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) {
        return 0;
    }
    
    int insertIndex = 1; // Start from the second element
    
    for (int i = 1; i < numsSize; i++) {
        // If current element is different from the previous element
        if (nums[i] != nums[i - 1]) {
            nums[insertIndex] = nums[i]; // Move it to the next unique position
            insertIndex++;               // Move the unique tracker forward
        }
    }
    
    return insertIndex; // Returns the total number of unique elements
}

#include <stdio.h>
int main()
{
    int num;
    printf("enter the array size:");
    scanf("%d",&num);
    int arr[num];
    printf("enter %d number:\n",num);
    for(int i = 0; i < num; i++)
    {
        scanf("%d",&arr[i]);
        
    }
    int max_count=0;
    int current_count=0;
    for (int i =0;i<num;i++)
    {
        if(arr[i] %2 ==0)
        {
            current_count++;
            if(current_count > max_count)
            {
                max_count = current_count;
                
            }
            
        }
        else
        {
            current_count = 0;
            
        }
        
    }
    printf("maximum continous evn numbers:%d\n", max_count);
    return 0;
}

#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
    // Array to store the last seen position (+1) of characters in s and t
    int mapS[256] = {0};
    int mapT[256] = {0};
    
    int len = strlen(s);

    for (int i = 0; i < len; i++) {
        // Cast chars to unsigned char to safely handle full ASCII range
        unsigned char charS = s[i];
        unsigned char charT = t[i];

        // If the last seen positions do not match, the strings are not isomorphic
        if (mapS[charS] != mapT[charT]) {
            return false;
        }

        // Record the current position (using i + 1 because 0 represents unvisited)
        mapS[charS] = i + 1;
        mapT[charT] = i + 1;
    }

    return true;
}

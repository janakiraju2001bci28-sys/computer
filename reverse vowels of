#include <string.h>
#include <stdbool.h>

// Helper function to efficiently check if a character is a vowel
bool isVowel(char c) {
    return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
           c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
}

char* reverseVowels(char* s) {
    int left = 0;
    int right = strlen(s) - 1;
    
    while (left < right) {
        // Move the left pointer forward until it hits a vowel
        while (left < right && !isVowel(s[left])) {
            left++;
        }
        // Move the right pointer backward until it hits a vowel
        while (left < right && !isVowel(s[right])) {
            right--;
        }
        
        // Swap the vowels if pointers haven't crossed
        if (left < right) {
            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;
            
            // Move both pointers inward
            left++;
            right--;
        }
    }
    
    return s;
}

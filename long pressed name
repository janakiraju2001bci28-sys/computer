#include <stdbool.h>
#include <string.h>

bool isLongPressedName(char* name, char* typed) {
    int i = 0;
    int j = 0;
    
    int name_len = strlen(name);
    int typed_len = strlen(typed);
    
    while (j < typed_len) {
        // If characters match, move both pointers forward
        if (i < name_len && name[i] == typed[j]) {
            i++;
            j++;
        } 
        // If they don't match, check if it's a valid long press
        else if (j > 0 && typed[j] == typed[j - 1]) {
            j++;
        } 
        // Invalid mismatch found
        else {
            return false;
        }
    }
    
    // Return true only if we successfully matched the entire 'name' string
    return i == name_len;
}

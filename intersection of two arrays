#include <stdlib.h>

// Comparison function needed for qsort
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int* intersect(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // 1. Sort both arrays
    qsort(nums1, nums1Size, sizeof(int), compare);
    qsort(nums2, nums2Size, sizeof(int), compare);
    
    // 2. Allocate memory for the result array
    // The intersection cannot be larger than the smaller array
    int minSize = (nums1Size < nums2Size) ? nums1Size : nums2Size;
    int* result = (int*)malloc(minSize * sizeof(int));
    
    int i = 0, j = 0, k = 0;
    
    // 3. Use two pointers to find common elements
    while (i < nums1Size && j < nums2Size) {
        if (nums1[i] < nums2[j]) {
            i++;
        } else if (nums1[i] > nums2[j]) {
            j++;
        } else {
            result[k++] = nums1[i];
            i++;
            j++;
        }
    }
    
    // 4. Set the dynamic size of the returned array
    *returnSize = k;
    return result;
}

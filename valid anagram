#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    if (len == 0) return true;
    if (len % 2 != 0) return false;

    // Allocate stack based on string length
    char stack[len];
    int top = -1;

    for (int i = 0; i < len; i++) {
        char current = s[i];

        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        else {
            if (top == -1) return false;

            char last_open = stack[top--];

            if ((current == ')' && last_open != '(') ||
                (current == '}' && last_open != '{') ||
                (current == ']' && last_open != '[')) {
                return false;
            }
        }
    }

    return top == -1;
}

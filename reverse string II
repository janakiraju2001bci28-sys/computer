#include <string.h>

char* reverseStr(char* s, int k) {
    int n = strlen(s);
    
    // Jump 2k elements in each iteration
    for (int i = 0; i < n; i += 2 * k) {
        int left = i;
        // Reverse up to k characters or till the end of the string
        int right = (i + k - 1 < n - 1) ? i + k - 1 : n - 1;
        
        // In-place swap
        while (left < right) {
            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;
            left++;
            right--;
        }
    }
    
    return s;
}

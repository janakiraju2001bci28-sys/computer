#include <stdlib.h>

/**
 * Note: The returned array must be Dynamic allocated (malloced), 
 * assume caller calls free().
 */
int* intersect(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // 1. Create a frequency array initialized to 0 for constraints (0 to 1000)
    int counts[1001] = {0};
    for (int i = 0; i < nums1Size; i++) {
        counts[nums1[i]]++;
    }
    
    // 2. Allocate memory for the result array
    // The intersection size cannot exceed the smaller array size
    int maxSize = (nums1Size < nums2Size) ? nums1Size : nums2Size;
    int* result = (int*)malloc(maxSize * sizeof(int));
    
    int index = 0;
    // 3. Iterate through nums2 and check counts
    for (int i = 0; i < nums2Size; i++) {
        if (counts[nums2[i]] > 0) {
            result[index++] = nums2[i];
            counts[nums2[i]]--; // Reduce frequency count
        }
    }
    
    // 4. Set the final return size
    *returnSize = index;
    return result;
}

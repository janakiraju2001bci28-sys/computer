#include <string.h>
#include <stdbool.h>
#include <stdlib.h>

// Helper function to check if two words differ by exactly one character
bool isAdjacent(const char* word1, const char* word2, int len) {
    int diffCount = 0;
    for (int i = 0; i < len; i++) {
        if (word1[i] != word2[i]) {
            diffCount++;
            if (diffCount > 1) return false;
        }
    }
    return diffCount == 1;
}

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int wordLen = strlen(beginWord);
    
    // Step 1: Check if endWord is even in the wordList
    int endWordIdx = -1;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            endWordIdx = i;
            break;
        }
    }
    if (endWordIdx == -1) return 0; // endWord not in dictionary

    // Step 2: Initialize arrays to track visited states
    // visited[i] tracks words from wordList
    bool* visited = (bool*)calloc(wordListSize, sizeof(bool));
    
    // Step 3: Implement Queue for BFS
    // The queue stores the indices of words in wordList. 
    // We use a special index (-1) to represent the beginWord.
    int* queue = (int*)malloc((wordListSize + 1) * sizeof(int));
    int head = 0, tail = 0;

    // Enqueue beginWord
    queue[tail++] = -1; 
    
    int level = 1; // Tracks the number of words in the sequence

    // Step 4: Perform BFS level by level
    while (head < tail) {
        int levelSize = tail - head; // Number of elements at the current BFS level

        for (int i = 0; i < levelSize; i++) {
            int currIdx = queue[head++];
            const char* currWord = (currIdx == -1) ? beginWord : wordList[currIdx];

            // If we reached the target word, return the level path length
            if (strcmp(currWord, endWord) == 0) {
                free(visited);
                free(queue);
                return level;
            }

            // Find all unvisited words that differ by exactly 1 character
            for (int j = 0; j < wordListSize; j++) {
                if (!visited[j] && isAdjacent(currWord, wordList[j], wordLen)) {
                    visited[j] = true;
                    queue[tail++] = j; // Enqueue the matching word index
                }
            }
        }
        level++; // Move to the next layer of transformations
    }

    // Clean up allocated memory if no path is found
    free(visited);
    free(queue);
    return 0;
}

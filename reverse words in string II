#include <string.h>

// Helper function to reverse a segment of a string in-place
void reverse(char* start, char* end) {
    while (start < end) {
        char temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    if (s == NULL) return NULL;
    
    int len = strlen(s);
    int word_start = 0;
    
    for (int i = 0; i <= len; i++) {
        // Reverse when we hit a space or the end of the string '\0'
        if (s[i] == ' ' || s[i] == '\0') {
            // s + word_start points to the first character of the word
            // s + i - 1 points to the last character of the word
            reverse(s + word_start, s + i - 1);
            
            // Set the start of the next word to the index after the space
            word_start = i + 1;
        }
    }
    
    return s;
}
